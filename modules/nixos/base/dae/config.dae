# dae 配置 —— 唯一的代理出口(节点选择已从 sing-box 完全迁移过来)
#
# 节点来源：dae 原生订阅（主/副订阅的 URL 在 agenix 里，由
# dae-sub-update.service 拉取后写到 /etc/dae/{main,backup}.sub）
#
# 【优先级方案】按字典序，用「同组内叠加 add_latency 偏置」实现：
#
#   1. 主订阅 优于 副订阅            (+0s   / +60s)
#   2. 1x 节点 优于 高倍率节点        (+0s   / +10s)
#   3. 区域：新加坡 > 港澳台 > 日韩 > 欧美及其他  (+0 / +1s / +2s / +3s)
#
# 同一层内部仍然按实时延迟优选(policy: min_moving_avg)，只有在更高优先级的
# 节点全都不可用(健康检查失败被剔除)时，才会用到下一层。
#
# AI 出口 proxy_ai 的层级完全一样，但**整组排除港澳台节点**。

global {
    log_level: info
    # lan_interface: wlp2s0 # 按需开启
    dial_mode: ip
    wan_interface: auto
}

# ============================================================
# 订阅：由 dae-sub-update.service 从 agenix 密钥拉取后写入
# 注意：dae 要求 file:// 订阅必须**位于配置文件所在目录内**
#       (源码 ResolveFile/EnsureFileInSubDir),所以这里用相对路径,
#       实际文件是 /etc/dae/main.sub 与 /etc/dae/backup.sub
# ============================================================
subscription {
    main_sub: 'file://./main.sub'
    backup_sub: 'file://./backup.sub'
}

# 节点全部来自上面的订阅(sing-box 节点池已移除)
group {
    # ========================================================
    # 通用出口：主订阅 > 1x > 新加坡 > 港澳台 > 日韩 > 欧美
    # ========================================================
    proxy {
        # ---- 主订阅 · 1x ----
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 0s]
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') [add_latency: 1s]
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 2s]
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 3s]
        # ---- 主订阅 · 高倍率 ----
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 10s]
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') [add_latency: 11s]
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 12s]
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 13s]
        # ---- 副订阅（兜底）· 1x ----
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 60s]
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') [add_latency: 61s]
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 62s]
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 63s]
        # ---- 副订阅（兜底）· 高倍率 ----
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 70s]
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') [add_latency: 71s]
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 72s]
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 73s]

        policy: min_moving_avg
    }

    # ========================================================
    # AI 出口：层级同 proxy，但**排除港澳台**
    # ========================================================
    proxy_ai {
        # ---- 主订阅 · 1x ----
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 0s]
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 1s]
        filter: subtag(main_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 2s]
        # ---- 主订阅 · 高倍率 ----
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 10s]
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 11s]
        filter: subtag(main_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 12s]
        # ---- 副订阅（兜底）· 1x ----
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 60s]
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 61s]
        filter: subtag(backup_sub) && name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 62s]
        # ---- 副订阅（兜底）· 高倍率 ----
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && name(regex: '(新加坡|狮城|獅城|Singapore)') [add_latency: 70s]
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') [add_latency: 71s]
        filter: subtag(backup_sub) && !name(regex: '(1x|1X|x1|X1|×1|1倍|一倍)') && !name(regex: '(新加坡|狮城|獅城|Singapore)') && !name(regex: '(香港|澳门|澳門|台湾|台灣|Hong ?Kong|Macau|Taiwan)') && !name(regex: '(日本|东京|東京|大阪|韩国|韓國|首尔|首爾|Japan|Korea|Tokyo|Osaka|Seoul)') && !name(regex: '(禁止|非法|下方|扣费|扣費|更新订阅|更新訂閱|ExpireAt|剩余|剩餘|到期|官网|官網|通知)') [add_latency: 72s]

        policy: min_moving_avg
    }
}

# 分流规则
routing {
    # --- 直连规则 ---
    # DNS/SSH 等相关进程强制直连
    pname(ssh, dnsmasq, dropbear) -> must_direct

    # DNS 地址或域名，强制直连
    dip(8.8.8.8) -> must_direct
    dip(1.1.1.1) -> must_direct
    domain(dns.alidns.com) -> must_direct
    domain(dns.google) -> must_direct
    domain(cloudflare-dns.com) -> must_direct

    # 目标 IP 多播、广播地址，直连
    dip(224.0.0.0/3, 'ff00::/8') -> direct

    # 目标 IP geoip 中的内网地址，直连
    dip(geoip:private) -> direct

    # 目标 IP 中国 IP，直连
    dip(geoip:cn) -> direct

    # 中国域名，直连
    domain(geosite:cn) -> direct

    # --- AI 服务：走专用出口（排除港澳台节点）---
    domain(geosite:category-ai-!cn) -> proxy_ai

    # 浏览器的进程直连 (浏览器使用proxy switchyomega)
    pname(msedge, firefox) -> direct

    # tailscale的进程直连
    pname(tailscaled) -> direct

    # git的进程直接忽略，让git自己走代理
    pname(git) -> direct

    # --- 拦截规则 ---
    # 广告域名，拒绝
    domain(geosite:category-ads) -> block
    l4proto(udp) && dport(443) -> block # 拦截 QUIC

    # --- 兜底规则 ---
    # 未命中上面规则的，全部走通用出口
    fallback: proxy
}
