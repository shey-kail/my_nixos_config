#!/usr/bin/env bash
# GstarCAD 2027 wrapper (generated by nix)
CAD_RUN_PATH=@APPDIR@/files
export QT_QPA_PLATFORM_PLUGIN_PATH=${CAD_RUN_PATH}/qtplugins/
export QT_PLUGIN_PATH=${CAD_RUN_PATH}/qtplugins/
export LD_LIBRARY_PATH="@SYS_LIB_PATH@:${CAD_RUN_PATH}:${CAD_RUN_PATH}/ConfigRes:${CAD_RUN_PATH}/Drivers:${CAD_RUN_PATH}/systemlibs"
export LD_PRELOAD=@FOPENFIX@/lib/fopen-fix.so
export DOTNET_ROOT=${CAD_RUN_PATH}/dotnet
export Env_User_Data=${HOME}/@APPID@
export Env_Tmp_Dir=/tmp/@APPID@
mkdir -p "${Env_User_Data}" "${HOME}/gcadlog" /tmp/@APPID@
cd "${CAD_RUN_PATH}" || exit 1
exec "${CAD_RUN_PATH}/gcad" -n enable -s disable "$@"